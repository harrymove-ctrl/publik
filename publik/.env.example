# Optional Solana devnet RPC. Mainnet URLs are ignored.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional override. Defaults to Circle's devnet USDC mint.
# Do not set the mainnet USDC mint.
VITE_DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional mainnet address the landing demo watches. View only. Leave empty to show example data.
# Never put a seed phrase or private key here.
VITE_DEMO_MAINNET_WATCH_ADDRESS=

# Public origin printed in the skill and pairing URL. Must match the address agents can reach.
PUBLIK_PUBLIC_ORIGIN=http://127.0.0.1:5173
VITE_PUBLIC_ORIGIN=http://127.0.0.1:5173
PUBLIK_API_PORT=8787
